{% extends 'base.html.twig' %}

{% block title %}{{ data_groupement.nom }} | Avec les femmes{% endblock %}

{% block body %}
<main class="contenu">
  <a class="retour" href="{{ path('app_groupement') }}">Tous les groupements</a>

  <div class="tete-page">
    <div>
      <h1>{{ data_groupement.nom }}</h1>
      <dl class="coordonnees">
        <div>
          <dt>Téléphone</dt>
          <dd>{{ data_groupement.tel }}</dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd>{{ data_groupement.adresse ?? 'Non renseignée' }}</dd>
        </div>
        <div>
          <dt>Membres</dt>
          <dd>{{ data_groupement.nombreMembres }}</dd>
        </div>
      </dl>
    </div>
  </div>

  {% if data_groupement.exerciceEnCours %}
  <section class="panneau" aria-labelledby="titre-exercice">
    <div class="entete-panneau">
      <div>
        <h2 id="titre-exercice">Exercice en cours</h2>
        <p class="sous-titre">Du {{ data_groupement.exerciceEnCours.debut }}{% if data_groupement.exerciceEnCours.fin %} au {{ data_groupement.exerciceEnCours.fin }}{% endif %}</p>
      </div>
    </div>

    <ol class="frise">
      {% for etape in data_groupement.exerciceEnCours.etapes %}
      <li class="etape{% if etape.etat %} etape--{{ etape.etat }}{% endif %}">
        <span class="etape__nom">{{ etape.nom }}</span>
        <span class="etape__date">{{ etape.date }}</span>
        {% if etape.note %}
        <span class="etape__note">{{ etape.note }}</span>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if data_groupement.historique %}
  <section class="panneau" aria-labelledby="titre-historique">
    <div class="entete-panneau">
      <h2 id="titre-historique">Historique des exercices</h2>
    </div>
    <div class="defilement">
      <table>
        <thead>
          <tr>
            <th scope="col">Période</th>
            <th scope="col">Statut</th>
            <th scope="col">Rétribution</th>
          </tr>
        </thead>
        <tbody>
          {% for exercice in data_groupement.historique %}
          <tr>
            <td>{{ exercice.periode }}</td>
            <td><span class="statut statut--{{ exercice.statutCode }}">{{ exercice.statut }}</span></td>
            <td>{{ exercice.retribution }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% else %}
  <section class="vide" aria-labelledby="titre-vide">
    <h2 id="titre-vide">Aucun exercice pour l’instant</h2>
    <p>Aucun exercice n’a encore été ouvert pour ce groupement : il n’y a donc pas de campagne ni de cotisation à afficher.</p>
  </section>
  {% endif %}

  <section class="panneau" aria-labelledby="titre-campagnes">
    <div class="entete-panneau">
      <h2 id="titre-campagnes">Campagnes</h2>
    </div>
    <div class="defilement">
      <table>
        <thead>
          <tr>
            <th scope="col">Campagne</th>
            <th scope="col">Type</th>
            <th scope="col">Périodicité</th>
            <th scope="col" class="nombre">Montant</th>
            <th scope="col" class="nombre">Membres</th>
            <th scope="col">Exercice</th>
          </tr>
        </thead>
        <tbody>
          {% for campagne in data_groupement.campagnes %}
          <tr>
            <td><a class="nom-groupement" href="{{ path('app_campagne_detail', {id: campagne.id}) }}">{{ campagne.nom }}</a></td>
            <td>{{ campagne.type }}</td>
            <td>{{ campagne.periodicite ?? '—' }}{% if campagne.jourRencontre %} <span class="discret">{{ campagne.jourRencontre }}</span>{% endif %}</td>
            <td class="nombre">{{ campagne.montant|number_format(0, ',', ' ') }} F</td>
            <td class="nombre">{{ campagne.nombreMembres }}</td>
            <td>{{ campagne.exercice }}</td>
          </tr>
          {% else %}
          <tr>
            <td colspan="6">Aucune campagne.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</main>
{% endblock %}